# Optional. Pre-fills the server address on the pairing screen when typing a
# code by hand. Pairing by scanning the QR in the workspace sets it for you.
# For a local server use your computer's Wi-Fi address, not localhost:
#   php artisan serve --host=0.0.0.0 --port=8000
EXPO_PUBLIC_DEFAULT_API_URL=http://192.168.1.20:8000/api
